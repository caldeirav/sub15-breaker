FROM docker.io/library/python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS build
COPY --from=ghcr.io/astral-sh/uv@sha256:60a2d8df620448e9cf55307eacb081ae2f3df90c5baecc9b75a89dd112f884a6 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --locked --only-group banking-service --no-install-project --no-editable --no-cache

FROM docker.io/library/python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
ENV PATH=/app/.venv/bin:$PATH PYTHONPATH=/app PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY src/__init__.py ./src/__init__.py
COPY src/banking_contracts ./src/banking_contracts
COPY src/banking_service ./src/banking_service
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["python", "-m", "src.banking_service.entrypoint"]
CMD ["actor"]
