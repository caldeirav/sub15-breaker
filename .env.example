# Supported native banking benchmark; preserve existing .env credentials.
# Live runs require the owned Substrate/gateway/Actor stack and verified artifacts.
# Offline tests and saved replay require no live model/provider service.
MLFLOW_TRACKING_URI=http://localhost:5001
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen/qwen3-30b-a3b-2507
# App/MLX runtime pins are in infra/versions.json; launcher checks, never changes LM Studio.
GEMINI_API_KEY=
# Generic benchmark judge default. Live UI pins Gemini2.5Flash in Runtime.review;
# it needs credentials and explicit Run clicks, not allocations. Provider charges apply.
MLFLOW_GENAI_JUDGE_DEFAULT_MODEL=gemini:/gemini-2.5-flash
# Legacy feasibility runner only; native benchmark selects breaker-banking-target-agent.
BANKING_MLFLOW_EXPERIMENT=breaker-banking-feasibility
# Use lock-bound bundled pricing metadata, avoiding remote GitHub import downloads.
LITELLM_LOCAL_MODEL_COST_MAP=True
# Legacy Bash scaffold settings below; not the supported native banking contract.
AGENTGATEWAY_URL=http://localhost:8080/execute
AGENTGATEWAY_URL_A=
AGENTGATEWAY_URL_B=
DECISION_SIDECAR_URL=http://localhost:8000
# Must reset the isolated sandbox before each trial (POST; non-2xx aborts trial).
EVAL_RESET_URL=
# A fine-tuned binary risk classifier and temperature fitted on held-out labels.
RISK_MODEL_PATH=
RISK_TEMPERATURE=
