# Legacy command-only prototype, not a banking risk-verifier image.
# See docs/legacy-compatibility.md; banking role-specific images remain future work.
FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /bin/

ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
COPY src ./src
RUN uv sync --locked --no-dev --no-editable --no-cache

# Derive a site-specific image that includes trained safety weights at /model.
EXPOSE 8000
CMD ["uv", "run", "--no-sync", "--no-dev", "uvicorn", "src.gateway.decision_sidecar:app", "--host", "0.0.0.0", "--port", "8000"]
